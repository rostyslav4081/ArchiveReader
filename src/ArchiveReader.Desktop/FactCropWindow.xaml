<Window x:Class="ArchiveReader.FactCropWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Фрагмент факту" Width="850" Height="800" MinWidth="700" MinHeight="600">
 <DockPanel Margin="18"><TextBlock DockPanel.Dock="Top" Text="Виділіть фрагмент мишею на оригінальній сторінці. Зображення не змінюється; зберігаються лише межі доказу." TextWrapping="Wrap" Margin="0,8"/>
 <DockPanel DockPanel.Dock="Bottom"><Button DockPanel.Dock="Right" Content="Зберегти фрагмент факту" Click="Save" Padding="10,7"/><TextBlock x:Name="Status" TextWrapping="Wrap"/></DockPanel>
 <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Canvas x:Name="Surface" Width="700" Background="Transparent" MouseLeftButtonDown="Begin" MouseMove="Move" MouseLeftButtonUp="End"><Image x:Name="PageImage" Width="700" Stretch="Fill" IsHitTestVisible="False"/><Rectangle x:Name="Selection" Stroke="OrangeRed" StrokeThickness="2" Fill="#30FFAA00" IsHitTestVisible="False"/></Canvas></ScrollViewer>
 </DockPanel>

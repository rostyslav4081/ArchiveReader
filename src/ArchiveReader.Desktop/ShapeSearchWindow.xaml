<Window x:Class="ArchiveReader.ShapeSearchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Схожі написання" Width="1000" Height="760" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="14"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Виберіть слово або сполучення штрихів. Шукаємо схожу форму в збережених рядках книги, без визначення писаря." TextWrapping="Wrap"/><WrapPanel Margin="0,10"><Button Content="Вибрати фрагмент" Click="Pick" Padding="10,6"/><Button x:Name="SearchButton" Content="Знайти схожі написання" Click="Search" IsEnabled="False" Padding="10,6" Margin="10,0"/><Button Content="Зупинити" Click="Stop" Padding="10,6"/></WrapPanel><Image x:Name="Query" Height="100" Stretch="Uniform"/></StackPanel>
 <StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,8"/><Button x:Name="ReportButton" Content="Відкрити звіт" Click="Report" IsEnabled="False" HorizontalAlignment="Left"/></StackPanel>
 <Grid Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition/></Grid.ColumnDefinitions><ListBox x:Name="Matches" DisplayMemberPath="Label" SelectionChanged="Select"/><StackPanel Grid.Column="1" Margin="12,0,0,0"><Image x:Name="Candidate" Height="200" Stretch="Uniform"/><TextBlock x:Name="Details" TextWrapping="Wrap" Margin="0,10"/><TextBlock Text="Текст поруч належить цілому рядку, а не знайденому фрагменту. Схожість не підтверджує літеру й не змінює транскрипцію." TextWrapping="Wrap"/></StackPanel></Grid>
 </DockPanel>
</Window>

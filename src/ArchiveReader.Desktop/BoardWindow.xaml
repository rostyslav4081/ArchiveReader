<Window x:Class="ArchiveReader.BoardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Дошка родоводу" Width="1350" Height="850" MinWidth="1000" MinHeight="650">
 <DockPanel Margin="12">
  <StackPanel DockPanel.Dock="Top"><WrapPanel><Button Content="Відкрити знімок дошки" Click="OpenSnapshot" Margin="4"/><Button Content="Імпортувати вибрані картки" Click="ImportBoard" Margin="4"/><Button Content="Зберегти дошку та вкладення" Click="ExportBoard" Margin="4"/></WrapPanel><TextBlock x:Name="Status" TextWrapping="Wrap" Margin="4" Text="Статуси зв’язків збережено за кольорами дошки. Виберіть вузли людей для імпорту карток."/>
  <TextBlock TextWrapping="Wrap" Margin="4" Text="Червоний — помилковий; жовтий — невирішений; сірий — логічно узгоджений за дошкою. Це не перевірка архівного доказу."/>
  <WrapPanel VerticalAlignment="Center"><Button Content="−" Click="ZoomOut" Padding="10,3"/><Slider x:Name="Zoom" Minimum="5" Maximum="200" Value="40" Width="180" ValueChanged="ZoomChanged"/><TextBlock x:Name="ZoomLabel" Margin="6"/><Button Content="+" Click="ZoomIn" Padding="10,3"/><Button Content="Показати всю дошку" Click="FitBoard" Margin="8,3"/></WrapPanel></StackPanel>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
   <DockPanel Margin="0,0,8,0"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Знайти людину або примітку"/><TextBox x:Name="Search" TextChanged="SearchChanged" KeyDown="SearchKey" Margin="0,4"/><WrapPanel><Button Content="Наступний збіг" Click="NextMatch"/><Button Content="Скинути пошук" Click="ClearSearch" Margin="6,0"/></WrapPanel><CheckBox x:Name="PeopleOnly" Content="Лише картки людей" Checked="SearchChanged" Unchecked="SearchChanged" Margin="0,5"/></StackPanel>
    <ListBox x:Name="Nodes" SelectionChanged="SelectNode"><ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding Person}" IsEnabled="{Binding CanPerson}" MaxWidth="225"><CheckBox.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></CheckBox.ContentTemplate></CheckBox></DataTemplate></ListBox.ItemTemplate></ListBox>
   </DockPanel>
   <ScrollViewer x:Name="Viewport" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FFF8F5EF"><Canvas x:Name="Board"><Canvas.LayoutTransform><ScaleTransform x:Name="BoardScale" ScaleX="0.4" ScaleY="0.4"/></Canvas.LayoutTransform></Canvas></ScrollViewer>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="10,0,0,0"><StackPanel><TextBox x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" MinHeight="150" MaxHeight="280" VerticalScrollBarVisibility="Auto"/><Button Content="Відкрити фото дошки" Click="OpenBoardPhoto" Margin="0,6"/><TextBlock Text="Документ і джерело" FontWeight="Bold" Margin="0,10,0,4"/><ListBox x:Name="EvidenceRows" SelectionChanged="SelectEvidence" MaxHeight="130" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" MaxWidth="300"/></DataTemplate></ListBox.ItemTemplate></ListBox><Image x:Name="EvidenceImage" MaxHeight="240" MinHeight="70" Stretch="Uniform" MouseLeftButtonDown="EnlargeEvidence" Margin="0,8"/><Button Content="Повний скан" Click="OpenFullScan" Margin="0,4"/><Button Content="Відкрити архівне посилання" Click="OpenSource" Margin="0,8"/><TextBox x:Name="EvidenceText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"/></StackPanel></ScrollViewer>
  </Grid>
 </DockPanel>
</Window>
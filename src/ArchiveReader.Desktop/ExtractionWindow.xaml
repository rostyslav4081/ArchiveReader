<Window x:Class="ArchiveReader.ExtractionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Пропозиції полів" Width="850" Height="720" MinWidth="700" MinHeight="600" Background="#F3F5F7">
 <DockPanel Margin="20"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Пропозиції полів із тексту" FontSize="22"/><TextBlock Text="Це підказки за явними підписами й датами. Оберіть одне значення на поле та перевірте його за оригіналом. Нерозбірливий текст автоматично не відновлюється." TextWrapping="Wrap" Margin="0,10"/><TextBlock x:Name="Citation" TextWrapping="Wrap"/><Button Content="Оновити пропозиції" Click="Reload" Margin="0,10"/></StackPanel>
 <StackPanel DockPanel.Dock="Bottom"><CheckBox x:Name="ReplaceExisting" Content="Дозволити заміну вже заповнених полів" Margin="0,10"/><Button Content="Зберегти вибрані поля як неперевірені" Click="Apply" Padding="10,7"/><TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,10"/></StackPanel>
 <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="170"/></Grid.RowDefinitions><ListBox x:Name="Candidates" SelectionMode="Extended" DisplayMemberPath="Label" SelectionChanged="ShowEvidence"/><TextBox Grid.Row="1" x:Name="Evidence" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10"/></Grid>
 </DockPanel>
</Window>

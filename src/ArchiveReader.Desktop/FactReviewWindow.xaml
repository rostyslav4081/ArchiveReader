<Window x:Class="ArchiveReader.FactReviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Факти та докази" Width="1100" Height="820" MinWidth="850" MinHeight="650">
 <DockPanel Margin="12"><TextBlock x:Name="Status" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8"/><TabControl x:Name="Tabs">
  <TabItem Header="Оцінка окремого факту"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10">
   <TextBlock Text="Оцінка факту не змінює оригінальну транскрипцію чи перевірку всього запису." TextWrapping="Wrap"/><ComboBox x:Name="Fields" DisplayMemberPath="Label" SelectionChanged="SelectField" Margin="0,8"/>
   <TextBlock Text="Значення факту"/><TextBox x:Name="Value"/><TextBlock Text="Стан факту" Margin="0,8,0,0"/>
   <ComboBox x:Name="FactState" SelectedIndex="0"><ComboBoxItem Content="Спостереження в документі" Tag="document_observation"/><ComboBoxItem Content="Прочитання тексту" Tag="transcription"/><ComboBoxItem Content="Гіпотеза" Tag="hypothesis"/><ComboBoxItem Content="Підтверджено незалежними джерелами" Tag="corroborated"/></ComboBox>
   <TextBlock Text="Пояснення оцінки" Margin="0,8,0,0"/><TextBox x:Name="Note" Height="65" AcceptsReturn="True" TextWrapping="Wrap"/>
   <TextBlock x:Name="Citation" TextWrapping="Wrap" Margin="0,8"/><Image x:Name="Scan" Height="170" Stretch="Uniform"/><Button Content="Вибрати фрагмент доказу" Click="PickEvidence" HorizontalAlignment="Left" Margin="0,4"/>
   <TextBlock Text="Додаткові докази: виберіть записи через Ctrl/Shift"/><DockPanel><Button Content="Знайти докази" DockPanel.Dock="Right" Click="FindSupports"/><TextBox x:Name="Query"/></DockPanel>
   <ListBox x:Name="Supports" DisplayMemberPath="Label" Height="115" SelectionMode="Extended"/>
   <CheckBox x:Name="Reviewed" Content="Я звірив факт з усіма вибраними джерелами" Margin="0,8"/>
   <Button Content="Зберегти оцінку факту" Click="SaveFact" HorizontalAlignment="Left"/>
   <TextBox x:Name="History" Height="150" Margin="0,8" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
  </StackPanel></ScrollViewer></TabItem>
  <TabItem Header="Сусідні сторінки"><DockPanel Margin="10"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Пропозиції показують збіги та відмінності. Вони не створюють зв’язків між людьми." TextWrapping="Wrap"/><Button Content="Перевірити сусідні сторінки" Click="FindNeighbors" HorizontalAlignment="Left" Margin="0,8"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><TextBox x:Name="NeighborEvidence" Height="180" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><Button Content="Відкрити запис-доказ" Click="OpenNeighbor" HorizontalAlignment="Left" Margin="0,8"/></StackPanel><ListBox x:Name="Neighbors" DisplayMemberPath="Label" SelectionChanged="SelectNeighbor"/></DockPanel></TabItem>
 </TabControl></DockPanel>
</Window>

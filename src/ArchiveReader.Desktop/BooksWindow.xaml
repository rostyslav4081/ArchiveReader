<Window x:Class="ArchiveReader.BooksWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Книги з фото" Width="1180" Height="820" MinWidth="950" MinHeight="650" WindowStartupLocation="CenterOwner">
 <Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="8,4"/><Setter Property="Margin" Value="2"/></Style><Style TargetType="TextBox"><Setter Property="Padding" Value="4"/><Setter Property="Margin" Value="0,2"/></Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="0,3"/></Style></Window.Resources>
 <DockPanel Margin="12">
  <StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,8"/><Button Content="Зупинити" Click="Stop" HorizontalAlignment="Right"/></StackPanel>
  <TabControl x:Name="Tabs">
   <TabItem Header="Збирання книги"><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0"><Button Content="Імпортувати папку фото" Click="ImportFolder"/><Button Content="Нова книга з вибраних сторінок" Click="NewBook"/><ListBox DisplayMemberPath="Label" x:Name="Books" Height="170" SelectionChanged="SelectBook"/><TextBlock Text="Назва книги"/><TextBox x:Name="BookName"/><Button Content="Зберегти порядок" Click="SaveBook"/><CheckBox x:Name="ReadImages" IsChecked="True"><CheckBox.Content><TextBlock Text="Рукописні або змішані сторінки: читати зображення" TextWrapping="Wrap"/></CheckBox.Content><CheckBox.ToolTip><TextBlock Text="PDF не означає друкований текст. Для рукопису виберіть Kraken і відповідну HTR-модель у головному вікні." TextWrapping="Wrap" Width="300"/></CheckBox.ToolTip></CheckBox><Button Content="Індексувати всю книгу" Click="IndexBook"/><Button Content="Експорт PDF із текстом" Click="ExportPdf"/><TextBlock x:Name="Coverage" TextWrapping="Wrap" Margin="0,8"/></StackPanel></ScrollViewer>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <WrapPanel><Button Content="Вище" Click="MoveUp"/><Button Content="Нижче" Click="MoveDown"/><Button Content="Вилучити зі збірки" Click="RemovePage"/><Button Content="Відкрити сторінку" Click="OpenPage"/></WrapPanel>
     <ListBox DisplayMemberPath="Label" x:Name="Items" Grid.Row="1" SelectionMode="Extended"/>
     <StackPanel Grid.Row="2"><TextBlock Text="Пропущений аркуш або назва сторінки"/><TextBox x:Name="Folio"/><WrapPanel><Button Content="Додати пропуск" Click="AddGap"/><Button Content="Змінити назву сторінки" Click="RenamePage"/></WrapPanel><TextBlock Text="Номер у збірці не змінює номер сторінки оригінального файла." TextWrapping="Wrap"/></StackPanel>
    </Grid>
   </Grid></TabItem>
   <TabItem Header="Пошук за ознаками"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><WrapPanel><StackPanel Width="190"><TextBlock Text="Ім’я або прізвище"/><TextBox x:Name="Person"/></StackPanel><StackPanel Width="190"><TextBlock Text="Населений пункт"/><TextBox x:Name="Place"/></StackPanel><StackPanel Width="100"><TextBlock Text="Номер будинку"/><TextBox x:Name="House"/></StackPanel><StackPanel Width="90"><TextBlock Text="Від року"/><TextBox x:Name="YearFrom"/></StackPanel><StackPanel Width="90"><TextBlock Text="До року"/><TextBox x:Name="YearTo"/></StackPanel></WrapPanel><CheckBox x:Name="CurrentBookOnly" Content="Лише вибрана книга"/><Button Content="Знайти записи" Click="Search"/><TextBlock Text="Пошук у збережених полях записів. Діапазони й неоднозначні роки не вважаються точними датами." TextWrapping="Wrap"/></StackPanel>
    <ListBox DisplayMemberPath="Label" x:Name="SearchRows" Grid.Row="1"/><StackPanel Grid.Row="2"><TextBlock Text="Текст для пошуку в OCR і виправленнях"/><TextBox x:Name="TextQuery"/><Button Content="Пошук у тексті книги" Click="SearchText"/><Button Content="Відкрити доказ" Click="OpenSearch"/></StackPanel>
   </Grid></TabItem>
   <TabItem Header="Завдання"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Завдання для поточної сторінки"/><TextBox x:Name="TaskText"/><WrapPanel><Button Content="Прочитати пізніше" Click="TaskPreset"/><Button Content="Перевірити дату" Click="TaskPreset"/><Button Content="Знайти інший примірник" Click="TaskPreset"/><Button Content="Вибрати фрагмент" Click="TaskRegion"/><Button Content="Додати завдання" Click="AddTask"/></WrapPanel><TextBlock x:Name="TaskRegionLabel" TextWrapping="Wrap"/><CheckBox x:Name="OpenTasksOnly" Content="Лише незавершені" IsChecked="True"/><Button Content="Оновити" Click="RefreshTasks"/></StackPanel>
    <ListBox DisplayMemberPath="Label" x:Name="Tasks" Grid.Row="1"/><WrapPanel Grid.Row="2"><Button Content="Відкрити фрагмент" Click="OpenTask"/><Button Content="Відкрити сторінку" Click="OpenTaskPage"/><Button Content="Завершити або повернути" Click="ToggleTask"/></WrapPanel>
   </Grid></TabItem>
   <TabItem Header="Колонки книги"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10"><TextBlock Text="Скопіюйте колонки з поточної сторінки. Інші сторінки з власними колонками залишаться без змін." TextWrapping="Wrap"/><Button Content="Зберегти колонки як шаблон книги" Click="CaptureTemplate"/><ListBox DisplayMemberPath="Label" x:Name="Columns" Height="230" SelectionChanged="SelectColumn"/><TextBlock Text="Назва колонки"/><TextBox x:Name="ColumnLabel"/><TextBlock Text="Поле запису"/><ComboBox x:Name="ColumnField"/><TextBlock Text="Значення вибраної колонки"/><TextBox x:Name="ColumnMeaning"/><Button Content="Зберегти значення" Click="SaveMeaning"/><Button Content="Застосувати до книги" Click="ApplyTemplate"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Пакетне порівняння"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10"><TextBlock Text="Порівняння використовує лише однакові вручну перевірені рядки окремого тестового набору. Воно не перевіряє якість поділу сторінки." TextWrapping="Wrap"/><Button Content="Зберегти перевірений тестовий набір" Click="Freeze"/><TextBlock Text="Збережений тестовий набір"/><TextBox x:Name="FrozenPath"/><Button Content="Вибрати набір" Click="ChooseFrozen"/><TextBlock Text="Модель A"/><TextBox x:Name="ModelA"/><Button Content="Вибрати модель A" Click="ChooseModel" Tag="A"/><TextBlock Text="Модель B"/><TextBox x:Name="ModelB"/><Button Content="Вибрати модель B" Click="ChooseModel" Tag="B"/><Button Content="Порівняти моделі" Click="Compare"/><TextBox x:Name="ComparisonReport" Height="210" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </DockPanel>
</Window>

<Window x:Class="ArchiveReader.ResearchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Збіги сканів і словник" Width="1050" Height="820" MinWidth="800" MinHeight="650">
 <Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,5,8,5"/></Style><Style TargetType="TextBox"><Setter Property="Margin" Value="0,5,0,8"/></Style></Window.Resources>
 <DockPanel Margin="18"><DockPanel DockPanel.Dock="Bottom"><Button DockPanel.Dock="Right" Content="Зупинити" Click="Stop"/><TextBlock x:Name="Status" TextWrapping="Wrap"/></DockPanel><TabControl x:Name="Tabs">
 <TabItem Header="Можливі дублікати"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
 <TextBlock Text="Схожість зображень не доводить, що це одна сторінка. Спільний фрагмент не дозволяє пропускати розпізнавання всієї сторінки." TextWrapping="Wrap"/>
 <WrapPanel><Button Content="Індексувати скани бібліотеки" Click="IndexScans"/><Button Content="Знайти схожі до поточної сторінки" Click="FindDuplicates"/></WrapPanel>
 <ListBox x:Name="DuplicateRows" Height="140" DisplayMemberPath="Label" SelectionChanged="ShowDuplicate"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Image x:Name="LeftImage" Height="230" Stretch="Uniform" MouseLeftButtonDown="EnlargeScan" ToolTip="Натисніть для збільшення"/><Image Grid.Column="1" x:Name="RightImage" Height="230" Stretch="Uniform" MouseLeftButtonDown="EnlargeScan" ToolTip="Натисніть для збільшення"/></Grid>
 <CheckBox x:Name="ReverseSource" Content="Використати знайдену сторінку як джерело" Margin="0,10"/>
 <TextBlock Text="Пояснення рішення"/><TextBox x:Name="DuplicateReason" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>
 <WrapPanel><Button Content="Та сама повна сторінка" Tag="confirmed_full" Click="DecideDuplicate"/><Button Content="Лише спільний фрагмент" Tag="related_fragment" Click="DecideDuplicate"/><Button Content="Різні сторінки" Tag="rejected" Click="DecideDuplicate"/></WrapPanel>
 <TextBlock Text="Черга може пропустити підтверджений повний дублікат лише тоді, коли сторінка-джерело вже розпізнана. Оригінали й записи не об’єднуються." TextWrapping="Wrap"/>
 </StackPanel></ScrollViewer></TabItem>
 <TabItem Header="Словник книги"><StackPanel Margin="12">
 <TextBlock Text="Словник належить поточній книзі. Збережені слова — підказки для ручного виправлення, без автоматичної заміни прочитання." TextWrapping="Wrap"/>
 <TextBox x:Name="WordQuery"/><Button Content="Знайти підказки словника" Click="SearchWords"/>
 <ListBox x:Name="Words" Height="190" DisplayMemberPath="Label"/>
 <TextBlock Text="Слово або скорочення"/><TextBox x:Name="WordTerm"/><ComboBox x:Name="WordKind" SelectedIndex="0"><ComboBoxItem Content="Ім’я / прізвище" Tag="name"/><ComboBoxItem Content="Населений пункт" Tag="place"/><ComboBoxItem Content="Скорочення" Tag="abbreviation"/></ComboBox>
 <TextBlock Text="Значення / пояснення"/>
 <TextBox x:Name="WordMeaning" Height="80" AcceptsReturn="True" TextWrapping="Wrap"/><CheckBox x:Name="WordVerified" Content="Я звірив слово та пояснення з оригіналом" Margin="0,8"/>
 <WrapPanel><Button Content="Додати перевірене слово" Click="AddWord"/><Button Content="Видалити вибрану підказку" Click="DeleteWord"/></WrapPanel>
 </StackPanel></TabItem></TabControl></DockPanel>
</Window>

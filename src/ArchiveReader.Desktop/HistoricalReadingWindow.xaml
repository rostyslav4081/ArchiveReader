<Window x:Class="ArchiveReader.HistoricalReadingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Історичне читання" Width="1150" Height="850" MinWidth="900" MinHeight="680">
 <DockPanel Margin="12"><TextBlock x:Name="Status" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8"/><TextBlock DockPanel.Dock="Top" Text="Буквальне прочитання, значення слів і висновки зберігаються окремо. Пропущені літери не домальовуються." TextWrapping="Wrap" Margin="0,0,0,10"/><TabControl x:Name="Tabs">
 <TabItem Header="Джерело й почерк"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
 <TextBlock Text="Походження документа"/><TextBox x:Name="Origin"/><TextBlock Text="Період"/><TextBox x:Name="Period"/><TextBlock Text="Установа"/><TextBox x:Name="Institution"/><TextBlock Text="Обряд"/><TextBox x:Name="Rite"/><TextBlock Text="Тип письма"/><TextBox x:Name="Script"/><TextBlock Text="Позначення почерку"/><TextBox x:Name="Writer"/><TextBlock Text="Ручне позначення групує зразки. Воно не доводить, що це одна рука чи одна людина." TextWrapping="Wrap"/><TextBlock Text="Мови через кому"/><TextBox x:Name="Languages"/><TextBlock Text="Примітки про джерело"/><TextBox x:Name="ProfileNotes" Height="90" AcceptsReturn="True" TextWrapping="Wrap"/><Button Content="Зберегти профіль джерела" Click="SaveProfile" HorizontalAlignment="Left" Margin="0,10"/>
 </StackPanel></ScrollViewer></TabItem>
 <TabItem Header="Історичний словник"><ScrollViewer x:Name="LexiconScroll" VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="Словникова підказка не замінює видимий текст документа." TextWrapping="Wrap"/><ListBox x:Name="Terms" Height="150" DisplayMemberPath="Label" SelectionChanged="SelectTerm"/><UniformGrid Columns="2"><StackPanel Margin="0,8,8,0"><TextBlock Text="Форма в документі"/><TextBox x:Name="Form"/><TextBlock Text="Лема"/><TextBox x:Name="Lemma"/><TextBlock Text="Значення"/><TextBox x:Name="Meaning"/><TextBlock Text="Спільне поняття (за бажанням)"/><TextBox x:Name="Concept" MaxLength="300"/><TextBlock Text="Мова"/><TextBox x:Name="TermLanguage"/></StackPanel><StackPanel Margin="0,8,0,0"><TextBlock Text="Період"/><TextBox x:Name="TermPeriod"/><TextBlock Text="Позначення почерку"/><TextBox x:Name="TermWriter"/><TextBlock Text="Тип підказки"/><ComboBox x:Name="TermKind" SelectedIndex="0"><ComboBoxItem Tag="word" Content="Слово"/><ComboBoxItem Tag="name" Content="Ім’я"/><ComboBoxItem Tag="place" Content="Місце"/><ComboBoxItem Tag="abbreviation" Content="Скорочення"/><ComboBoxItem Tag="ligature" Content="Лігатура"/><ComboBoxItem Tag="calendar" Content="Календар"/><ComboBoxItem Tag="other" Content="Інше"/><ComboBoxItem Tag="orthography" Content="Правопис"/><ComboBoxItem Tag="grammar" Content="Граматика"/><ComboBoxItem Tag="paleography" Content="Палеографія"/></ComboBox></StackPanel></UniformGrid><TextBlock Text="Примітка до підказки"/><TextBox x:Name="TermNote" Height="65" AcceptsReturn="True" TextWrapping="Wrap"/><StackPanel x:Name="TermReferencePanel" Margin="0,10"><TextBlock Text="Довідкове джерело (за бажанням)" FontWeight="Bold"/><TextBlock Text="Час створення твору, рукописного примірника й видання — різні відомості. Межі застосування перевіряє людина." TextWrapping="Wrap"/><StackPanel x:Name="ReferenceCatalogPanel" Margin="0,8"><TextBlock Text="Каталог довідкових джерел"/><ComboBox x:Name="SourceCatalog" DisplayMemberPath="Label" SelectionChanged="SelectReferenceSource"/><TextBlock x:Name="SourceCatalogStatus" TextWrapping="Wrap"/><Button Content="Вставити джерело у підказку" Click="InsertReferenceSource" HorizontalAlignment="Left" Margin="0,6"/></StackPanel><UniformGrid Columns="2"><StackPanel Margin="0,0,8,0"><TextBlock Text="Назва довідкового джерела"/><TextBox x:Name="ReferenceTitle" MaxLength="4000"/><TextBlock Text="Посилання HTTP або HTTPS"/><TextBox x:Name="ReferenceUrl" MaxLength="2000"/><TextBlock Text="Сторінка, розділ або місце у джерелі"/><TextBox x:Name="ReferenceLocator" MaxLength="4000"/><TextBlock Text="Тип довідкового джерела"/><TextBox x:Name="ReferenceType" MaxLength="2000"/></StackPanel><StackPanel><TextBlock Text="Час створення твору"/><TextBox x:Name="ReferenceWorkPeriod" MaxLength="2000"/><TextBlock Text="Дата рукописного примірника"/><TextBox x:Name="ReferenceWitnessPeriod" MaxLength="2000"/><TextBlock Text="Час видання або опису"/><TextBox x:Name="ReferenceEditionPeriod" MaxLength="2000"/></StackPanel></UniformGrid><TextBlock Text="Межі застосування: мова, регіон, тип документа"/><TextBox x:Name="ReferenceScope" MaxLength="4000" Height="55" AcceptsReturn="True" TextWrapping="Wrap"/><TextBlock Text="Автентичність і характер правила"/><TextBox x:Name="ReferenceAuthenticity" MaxLength="4000" Height="45" AcceptsReturn="True" TextWrapping="Wrap"/><CheckBox x:Name="ReferenceChecked" Content="Я перевірив це довідкове джерело та місце у ньому"/><Button Content="Показати приклад правила з джерелом" Click="LoadReferenceExample" HorizontalAlignment="Left" Margin="0,6"/></StackPanel><CheckBox x:Name="TermChecked" Content="Я перевірив цю словникову підказку" Margin="0,8"/><WrapPanel><Button Content="Зберегти словникову підказку" Click="SaveTerm"/><Button Content="Очистити поля" Click="ClearTerm" Margin="8,0"/></WrapPanel></StackPanel></ScrollViewer></TabItem>
 <TabItem Header="Читання й тлумачення"><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions><ListBox x:Name="Regions" DisplayMemberPath="Label" SelectionChanged="SelectRegion" Margin="0,0,10,0"/><ScrollViewer x:Name="AnalysisScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel><Image x:Name="SourceCrop" Height="125" Stretch="Uniform"/><TextBlock Text="Поточне буквальне прочитання"/><TextBox x:Name="Literal" IsReadOnly="True" TextWrapping="Wrap" MinHeight="45"/><TextBlock Text="Неперевірені варіанти моделей" Margin="0,8,0,0"/><TextBox x:Name="Alternatives" IsReadOnly="True" TextWrapping="Wrap" MinHeight="65"/><TextBlock Text="Видима форма → лема → значення" Margin="0,8,0,0"/><TextBox x:Name="Tokens" IsReadOnly="True" TextWrapping="Wrap" MinHeight="80"/><TextBlock Text="Контекст і застереження" Margin="0,8,0,0"/><TextBox x:Name="Context" IsReadOnly="True" TextWrapping="Wrap" MinHeight="65"/><Expander x:Name="WordPanel" Header="Сумнівне слово" Margin="0,8"><StackPanel><TextBlock Text="Виберіть слово зі збереженого тексту або виділіть буквальний фрагмент. Підказки не виправляють його автоматично." TextWrapping="Wrap"/><ComboBox x:Name="WordTokens" DisplayMemberPath="Label" SelectionChanged="SelectWordToken"/><WrapPanel Margin="0,5"><Button Content="Взяти виділений текст" Click="UseLiteralSelection"/><TextBlock x:Name="WordSpan" Margin="8,3"/><Button Content="Показати докази слова" Click="InspectWord"/></WrapPanel><Button Content="Виділити фрагмент слова вручну" Click="PickWordCrop" HorizontalAlignment="Left"/><TextBlock x:Name="WordGeometry" TextWrapping="Wrap"/><Image x:Name="WordCrop" Height="100" Stretch="Uniform"/><TextBlock Text="Дослівний фрагмент"/><TextBox x:Name="WordLiteral" IsReadOnly="True" TextWrapping="Wrap"/><TextBlock Text="Текстове зіставлення може охоплювати кілька слів. Перевірте його на скані; повні прочитання збережено." TextWrapping="Wrap"/><TextBox x:Name="WordEvidence" IsReadOnly="True" TextWrapping="Wrap" MinHeight="140"/><Button Content="Відкрити повторне розпізнавання рядка або запису" Click="RequestParentRecognition" HorizontalAlignment="Left" Margin="0,6"/><TextBlock Text="Зразки почерку нижче служать лише ручному порівнянню рисок." TextWrapping="Wrap"/></StackPanel></Expander><TextBlock Text="Зразки з тим самим позначенням почерку" Margin="0,8,0,0"/><ListBox x:Name="HandReferences" DisplayMemberPath="Label" Height="75" SelectionChanged="SelectHandReference"/><TextBlock x:Name="HandStatus" TextWrapping="Wrap"/><Image x:Name="HandSample" Height="90" Stretch="Uniform"/><TextBlock Text="Моє буквальне прочитання" Margin="0,8,0,0"/><TextBox x:Name="Reading" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="55"/><TextBlock Text="Моє тлумачення"/><TextBox x:Name="Interpretation" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="55"/><TextBlock Text="Примітка до прочитання"/><TextBox x:Name="DecisionNote" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40"/><CheckBox x:Name="Uncertain" Content="У прочитанні залишилася невпевненість" IsChecked="True"/><CheckBox x:Name="DecisionChecked" Content="Я звірив прочитання з цим фрагментом"/><Button Content="Зберегти окреме прочитання" Click="SaveDecision" HorizontalAlignment="Left" Margin="0,8"/></StackPanel></ScrollViewer></Grid></TabItem>
 <TabItem Header="Структура й зразки літер"><ScrollViewer x:Name="StructureScroll" VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="Структура сторінки" FontWeight="Bold"/><Button Content="Запропонувати сітку таблиці" Click="ProposeStructure" HorizontalAlignment="Left"/><TextBlock Text="Лінії сітки не визначають зміст комірок чи ілюстрації. Підказка нічого не виключає автоматично." TextWrapping="Wrap"/><ListBox x:Name="Proposals" DisplayMemberPath="Label" Height="75" SelectionChanged="SelectProposal"/><Image x:Name="LayoutPreview" Height="150" Stretch="Uniform"/><WrapPanel><ComboBox x:Name="LayoutRole" SelectedIndex="0" Width="230"><ComboBoxItem Tag="text" Content="Текст"/><ComboBoxItem Tag="table" Content="Таблиця"/><ComboBoxItem Tag="illustration" Content="Ілюстрація"/><ComboBoxItem Tag="caption" Content="Підпис"/><ComboBoxItem Tag="unknown" Content="Невідомо"/><ComboBoxItem Tag="damage" Content="Пошкодження"/></ComboBox><Button Content="Виділити ділянку сторінки" Click="PickLayout" Margin="8,0"/></WrapPanel><TextBlock x:Name="LayoutBounds" TextWrapping="Wrap"/><TextBox x:Name="LayoutNote" Height="45" AcceptsReturn="True" TextWrapping="Wrap"/><CheckBox x:Name="LayoutChecked" Content="Я перевірив роль виділеної ділянки"/><Button Content="Зберегти ділянку структури" Click="SaveLayout" HorizontalAlignment="Left" Margin="0,6"/><ListBox x:Name="Layouts" DisplayMemberPath="Label" Height="95"/><Separator Margin="0,10"/><TextBlock Text="Зразок літери або лігатури" FontWeight="Bold"/><TextBlock Text="Спочатку виберіть рядок на вкладці читання. Зразок вирізається лише всередині цього рядка." TextWrapping="Wrap"/><Image x:Name="ExemplarPreview" Height="110" Stretch="Uniform"/><Button Content="Виділити зразок у рядку" Click="PickExemplar" HorizontalAlignment="Left"/><TextBlock x:Name="ExemplarBounds" TextWrapping="Wrap"/><TextBlock Text="Позначення літери або лігатури"/><TextBox x:Name="ExemplarLabel"/><TextBlock Text="Примітка до зразка"/><TextBox x:Name="ExemplarNote" Height="45" AcceptsReturn="True" TextWrapping="Wrap"/><CheckBox x:Name="ExemplarChecked" Content="Я звірив позначення з видимими рисками"/><Button Content="Зберегти зразок без донавчання" Click="SaveExemplar" HorizontalAlignment="Left" Margin="0,6"/><ListBox x:Name="Exemplars" DisplayMemberPath="Label" Height="100" SelectionChanged="SelectExemplar"/></StackPanel></ScrollViewer></TabItem>
 <TabItem Header="Мови світу"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Це реєстр назв і кодів мов, діалектів та мовних сімей. Наявність у ньому не означає підтримку розпізнавання чи перекладу." TextWrapping="Wrap" Margin="0,0,0,8"/><TextBlock Text="Пошук за англійською назвою, ISO або Glottocode"/><DockPanel Margin="0,4,0,8"><Button DockPanel.Dock="Right" Content="Шукати в реєстрі мов" Click="FindLanguages"/><TextBox x:Name="LanguageQuery" MaxLength="200" KeyDown="LanguageQueryKey"/></DockPanel></StackPanel><StackPanel DockPanel.Dock="Bottom"><WrapPanel Margin="0,8"><Button x:Name="PreviousLanguages" Content="Попередні мови" Click="PreviousLanguagePage"/><TextBlock x:Name="LanguageRange" Margin="12,4"/><Button x:Name="NextLanguages" Content="Наступні мови" Click="NextLanguagePage"/></WrapPanel><TextBlock Text="Відомості вибраного запису" FontWeight="Bold"/><TextBox x:Name="LanguageDetails" IsReadOnly="True" TextWrapping="Wrap" Height="95" VerticalScrollBarVisibility="Auto"/><TextBlock Text="Походження даних і ліцензія" FontWeight="Bold" Margin="0,8,0,0"/><TextBox x:Name="LanguageProvenance" IsReadOnly="True" TextWrapping="Wrap" Height="130" VerticalScrollBarVisibility="Auto"/></StackPanel><DataGrid x:Name="LanguageRows" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="SelectLanguage" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="Ідентифікатор" Binding="{Binding Id}" Width="120"/><DataGridTextColumn Header="Назва в реєстрі" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="ISO 639-3" Binding="{Binding Iso}" Width="100"/><DataGridTextColumn Header="Рівень" Binding="{Binding Level}" Width="170"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
<TabItem Header="Пакет знань книги"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="Пакет обмежує підказки цієї книги вибраними відповідниками й довідковими джерелами. Це не навчання моделі й не автоматичний вибір мов." TextWrapping="Wrap"/><TextBlock x:Name="PackageContext" TextWrapping="Wrap" Margin="0,8"/><CheckBox x:Name="PackageConfigured" Content="Використовувати вибраний пакет книги"/><TextBlock Text="Без окремого пакета доступні збережені підказки книги. Увімкнений порожній пакет вимикає всі словникові підказки." TextWrapping="Wrap" Margin="0,6"/><TextBlock Text="Для вибору кількох рядків використовуйте Ctrl або Shift." TextWrapping="Wrap"/><UniformGrid Columns="2"><StackPanel Margin="0,8,8,0"><TextBlock Text="Відповідники цієї книги" FontWeight="Bold"/><ListBox x:Name="PackageTerms" DisplayMemberPath="Label" SelectionMode="Extended" Height="300"/></StackPanel><StackPanel Margin="0,8,0,0"><TextBlock Text="Довідкові джерела пакета" FontWeight="Bold"/><ListBox x:Name="PackageSources" DisplayMemberPath="Label" SelectionMode="Extended" Height="300"/></StackPanel></UniformGrid><TextBlock Text="Примітка до вибору пакета" Margin="0,8,0,0"/><TextBox x:Name="PackageNotes" AcceptsReturn="True" TextWrapping="Wrap" Height="80"/><CheckBox x:Name="PackageChecked" Content="Я перевірив власний вибір складових пакета" Margin="0,8"/><Button Content="Зберегти пакет книги" Click="SavePackage" HorizontalAlignment="Left"/><TextBlock x:Name="PackageWarnings" TextWrapping="Wrap" Margin="0,8"/></StackPanel></ScrollViewer></TabItem>
 </TabControl></DockPanel>
</Window>

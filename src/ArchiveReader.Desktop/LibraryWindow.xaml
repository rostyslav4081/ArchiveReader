<Window x:Class="ArchiveReader.LibraryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Перевірка бібліотеки" Width="1180" Height="830" MinWidth="980" MinHeight="620" Background="#F3F5F7">
 <Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,5,8,5"/></Style></Window.Resources>
 <DockPanel Margin="18">
  <TextBlock DockPanel.Dock="Top" Text="Пошук і перевірка джерел" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <DockPanel DockPanel.Dock="Bottom"><Button DockPanel.Dock="Right" Content="Зупинити" Click="Cancel"/><TextBlock x:Name="Status" TextWrapping="Wrap"/></DockPanel>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TabControl x:Name="Tabs" Margin="0,0,15,0">
    <TabItem Header="Черга перевірки"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Розбіжності моделей, помилки й позначені пошкодження." TextWrapping="Wrap"/><WrapPanel><Button Content="Оновити чергу" Click="RefreshReview"/><Button Content="Позначити розглянутим" Click="Resolve"/></WrapPanel></StackPanel><ListBox x:Name="ReviewRows" DisplayMemberPath="Label" SelectionChanged="SelectReview"/></DockPanel></TabItem>
    <TabItem Header="Пошук"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Пошук у всій бібліотеці: OCR, виправлення, записи та примітки ділянок." TextWrapping="Wrap"/><TextBox x:Name="Query" Margin="0,8"/><Button Content="Знайти" Click="Search"/></StackPanel><ListBox x:Name="SearchRows" DisplayMemberPath="Label" SelectionChanged="SelectSearch"/></DockPanel></TabItem>
    <TabItem Header="Історія"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Версії вибраної сторінки. Перегляньте текст перед відновленням." TextWrapping="Wrap"/><WrapPanel><Button Content="Оновити історію" Click="RefreshHistory"/><Button Content="Відновити цю версію" Click="Restore"/></WrapPanel></StackPanel><ListBox x:Name="HistoryRows" DisplayMemberPath="Label" SelectionChanged="SelectHistory"/></DockPanel></TabItem>
    <TabItem Header="Шаблони"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Збережіть колонки поточної сторінки та застосуйте до вибраних сторінок цієї книги. Сторінки з колонками пропускаються." TextWrapping="Wrap"/><TextBox x:Name="TemplateName" Margin="0,8"/><Button Content="Зберегти шаблон колонок" Click="SaveTemplate"/><ComboBox x:Name="Templates" DisplayMemberPath="Label"/><WrapPanel><Button Content="Вибрати всі сторінки" Click="SelectAllPages"/><Button Content="Застосувати шаблон" Click="ApplyTemplate"/></WrapPanel></StackPanel><ListBox x:Name="TemplatePages" SelectionMode="Extended" DisplayMemberPath="Label"/></DockPanel></TabItem>
    <TabItem Header="Тестовий набір"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Огляд перевірених рядків за книгами, мовами й почерками. Ролі задаються в профілі книги. Збережений набір не змінюється після нових виправлень." TextWrapping="Wrap"/><WrapPanel><Button Content="Оновити набір" Click="RefreshBenchmark"/><Button Content="Зберегти знімок набору" Click="Freeze"/></WrapPanel></StackPanel><ListBox x:Name="BenchmarkRows" DisplayMemberPath="Label"/></DockPanel></TabItem>
   </TabControl>
   <DockPanel Grid.Column="1">
    <WrapPanel DockPanel.Dock="Top"><Button Content="Перейти до джерела" Click="GoToSource"/><Button Content="Відкрити збережений набір" Click="OpenFrozen"/></WrapPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="DetailTitle" FontSize="17" TextWrapping="Wrap" Margin="0,6"/><Grid x:Name="ContextGrid" Width="500"><Image x:Name="ContextImage" Width="500" Stretch="Fill"/><Canvas x:Name="FocusOverlay" IsHitTestVisible="False"/></Grid><TextBlock x:Name="Snippet" TextWrapping="Wrap" Margin="0,12"/><TextBox x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="180" MaxHeight="360"/></StackPanel></ScrollViewer>
   </DockPanel>
  </Grid>
 </DockPanel>
</Window>

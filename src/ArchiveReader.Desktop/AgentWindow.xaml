<Window x:Class="ArchiveReader.AgentWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Помічники розпізнавання" Width="1050" Height="780" MinWidth="800" MinHeight="600">
 <DockPanel Margin="15">
  <TextBlock DockPanel.Dock="Top" Text="Моделі читають один рядок незалежно. Збіг залишається неперевіреним; виправлення підтверджує людина." TextWrapping="Wrap" Margin="0,0,0,10"/>
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="Збережений рядок"/><ComboBox DisplayMemberPath="Label" x:Name="Regions" Margin="0,4,0,8"/>
   <TextBlock Text="Модель A — Kraken: файл моделі"/><DockPanel><Button DockPanel.Dock="Right" Content="Вибрати" Tag="A" Click="ChooseModel"/><TextBox x:Name="ModelA" Margin="0,4,0,8"/></DockPanel>
   <TextBlock Text="Модель B — TrOCR: локальна папка"/><DockPanel><Button DockPanel.Dock="Right" Content="Вибрати" Tag="B" Click="ChooseModel"/><TextBox x:Name="ModelB" Margin="0,4,0,8"/></DockPanel>
   <WrapPanel><Button Content="Створити завдання" Click="Create" Padding="10,5"/><Button Content="Наступний крок / повторити" Click="Step" Padding="10,5"/><Button Content="Зупинити" Click="StopWork" Padding="10,5"/><Button Content="Скасувати завдання" Click="CancelJob" Padding="10,5"/></WrapPanel>
   <Button Content="Навчити окрему модель A та перевірити на тестових книгах" Click="TrainCandidate" HorizontalAlignment="Left" Padding="10,5" Margin="0,6,0,0"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
   <TextBlock Text="Моє прочитання оригіналу"/><TextBox x:Name="Correction" AcceptsReturn="True" Height="65" VerticalScrollBarVisibility="Auto"/>
   <CheckBox x:Name="Checked" Content="Перевірено мною на оригіналі" Margin="0,6"/>
   <Button Content="Зберегти навчальний приклад" Click="Review" HorizontalAlignment="Left" Padding="10,5"/>
   <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,6"/>
  </StackPanel>
  <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListBox DisplayMemberPath="Label" x:Name="Jobs" SelectionChanged="SelectJob"/><DockPanel Grid.Column="1" Margin="10,0,0,0"><Image x:Name="Evidence" DockPanel.Dock="Top" Height="100" Stretch="Uniform"/><TextBox x:Name="Report" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></DockPanel></Grid>
 </DockPanel>
</Window>

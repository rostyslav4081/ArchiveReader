<Window x:Class="ArchiveReader.BackupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Резервні копії" Width="850" Height="650" MinWidth="700" MinHeight="550" Background="#F3F5F7">
 <StackPanel Margin="20">
  <TextBlock Text="Резервні копії бібліотеки" FontSize="22" FontWeight="SemiBold"/>
  <TextBlock Text="Зберігаються база записів та імпортовані оригінали. Моделі, навчальні файли й звіти OCR не включені. Для захисту від втрати диска оберіть інший диск." TextWrapping="Wrap" Margin="0,10"/>
  <CheckBox x:Name="Automatic" Content="Автоматично при запуску та кожні дві години роботи" Margin="0,8"/>
  <TextBlock Text="Папка резервних копій"/><TextBox x:Name="VaultPath" IsReadOnly="True" Margin="0,5"/>
  <WrapPanel><Button Content="Обрати папку копій" Click="ChooseVault" Padding="10,7"/><Button Content="Зберегти налаштування копій" Click="SaveSettings" Padding="10,7" Margin="8,0"/><Button Content="Створити копію зараз" Click="CreateBackup" Padding="10,7"/></WrapPanel>
  <TextBlock Text="Зберігаються сім останніх знімків бази. Спільні оригінали не видаляються. Переносьте всю папку копій разом із objects і snapshots." TextWrapping="Wrap" Margin="0,10"/>
  <ListBox x:Name="Snapshots" Height="190" DisplayMemberPath="Label"/>
  <WrapPanel Margin="0,10"><Button Content="Відновити вибрану копію" Click="RestoreBackup" Padding="10,7"/><Button Content="Відновити з іншої папки копій" Click="RestoreOther" Padding="10,7" Margin="8,0"/></WrapPanel>
  <TextBlock Text="Відновлення створює нову папку й не замінює поточну бібліотеку. Закрийте ArchiveReader і запустіть Open-RestoredLibrary.cmd у відновленій папці." TextWrapping="Wrap"/>
  <TextBlock x:Name="Report" TextWrapping="Wrap" Margin="0,12"/>
 </StackPanel>
</Window>
